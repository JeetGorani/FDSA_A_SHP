#include <iostream>
#include <vector>

int binarySearchIterative(const std::vector<int>& books, int target) {
    int left = 0;
    int right = books.size() - 1;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        if (books[mid] == target) {
            return mid;
        }
        if (books[mid] < target) {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }

    return -1;
}

int binarySearchRecursive(const std::vector<int>& books, int left, int right, int target) {
    if (left > right) {
        return -1;
    }

    int mid = left + (right - left) / 2;

    if (books[mid] == target) {
        return mid;
    }
    if (books[mid] < target) {
        return binarySearchRecursive(books, mid + 1, right, target);
    } else {
        return binarySearchRecursive(books, left, mid - 1, target);
    }
}

int main() {
    std::vector<int> bookCodes = {101, 105, 112, 120, 135, 140, 150};
    int target = 135;

    int indexLoop = binarySearchIterative(bookCodes, target);

    int indexRecursive = binarySearchRecursive(bookCodes, 0, bookCodes.size() - 1, target);

    std::cout << "Target book code: " << target << "\n";
    std::cout << "Position (Iterative): " << indexLoop << "\n";
    std::cout << "Position (Recursive): " << indexRecursive << "\n";

    return 0;
}
