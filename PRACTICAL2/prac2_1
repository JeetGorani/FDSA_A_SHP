#include<iostream>
#include<vector>
#include<string>

using namespace std;
int searchloop(string a[],int n,string x)
{
    for(int i=0;i<n;i++)
    {
        if(a[i]==x)
            return i;
    }
    return -1;

}
int searchrec(string a[],int n,string x,int i=0)
{
    if(i>=n)return -1;
    if(a[i]==x )return i;
    return searchrec(a,n,x,i+1);
}
int main()
{
    string a[] = {"ABC", "XYZ", "LMN", "PQR", "DEF"};
    int n = 5;

    string x;

    cout << "ENTER NO. OF PLATE : ";
    cin >> x;
    cout << "LOOP INDEX : " << searchloop(a, n, x) << endl;
    cout << "REC INDEX : " << searchrec(a, n, x) << endl;

    return 0;
}

